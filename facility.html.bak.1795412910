<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ASAS Facility Services — Pilot Zona 1</title>
  <style>
    :root {
      --bg-page: #f4f7fb;
      --surface-white: #ffffff;
      --surface-ice-soft: #f7faff;
      --navy-900: #0f2744;
      --navy-700: #1e3a5f;
      --slate-600: #475569;
      --border-soft: #dbe6f2;
      --teal-600: #0d9488;
      --teal-700: #0f766e;
      --teal-soft: #e6f7f5;
      --coral-cta: #e05a47;
      --coral-cta-hover: #c94a38;
      --shadow-card: 0 6px 20px rgba(15, 39, 68, 0.06);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
      background: var(--bg-page);
      color: var(--navy-900);
      -webkit-font-smoothing: antialiased;
    }

    .fs-topbar {
      position: sticky;
      top: 0;
      z-index: 25;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border-soft);
    }

    .fs-topbar-inner {
      max-width: 480px;
      margin: 0 auto;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .fs-brand strong {
      display: block;
      font-size: 18px;
      font-weight: 800;
      color: var(--navy-900);
    }

    .fs-brand span {
      display: block;
      font-size: 12px;
      color: var(--slate-600);
    }

    .fs-pill-outline {
      border: 1.5px solid var(--navy-700);
      background: var(--surface-white);
      color: var(--navy-900);
      font-weight: 600;
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 999px;
      cursor: pointer;
    }

    .fs-container {
      max-width: 480px;
      margin: 0 auto;
      padding: 16px;
    }

    .fs-hero {
      background: linear-gradient(135deg, #e7f1fc 0%, #f5f9ff 100%);
      border: 1px solid var(--border-soft);
      border-radius: 20px;
      padding: 18px;
      box-shadow: var(--shadow-card);
    }

    .fs-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .fs-badge-navy {
      background: var(--navy-900);
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.4px;
      padding: 5px 10px;
      border-radius: 999px;
    }

    .fs-badge-light {
      background: var(--surface-white);
      color: var(--navy-900);
      border: 1px solid var(--border-soft);
      font-size: 11px;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: 999px;
    }

    .fs-hero h1 {
      margin: 12px 0 8px;
      font-size: 26px;
      line-height: 1.2;
      color: var(--navy-900);
    }

    .fs-hero p {
      margin: 0 0 16px;
      font-size: 14px;
      line-height: 1.5;
      color: var(--slate-600);
    }

    .fs-hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .fs-btn-primary {
      background: var(--coral-cta);
      color: #ffffff;
      border: none;
      border-radius: 999px;
      padding: 11px 14px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .fs-btn-primary:hover {
      background: var(--coral-cta-hover);
    }

    .fs-btn-secondary {
      background: var(--surface-white);
      color: var(--navy-900);
      border: 1.5px solid var(--navy-700);
      border-radius: 999px;
      padding: 11px 14px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    .fs-section {
      margin-top: 22px;
    }

    .fs-eyebrow {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: var(--teal-700);
      margin-bottom: 4px;
    }

    .fs-section h2 {
      margin: 0 0 6px;
      font-size: 20px;
      color: var(--navy-900);
    }

    .fs-sub {
      margin: 0 0 14px;
      font-size: 13.5px;
      line-height: 1.45;
      color: var(--slate-600);
    }

    .fs-services-panel {
      background: var(--surface-white);
      border: 1px solid var(--border-soft);
      border-radius: 20px;
      padding: 14px;
      box-shadow: var(--shadow-card);
    }

    .fs-services-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .fs-service-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
      padding: 14px;
      border-radius: 16px;
      border: 1.5px solid var(--border-soft);
      background: var(--surface-ice-soft);
      text-align: left;
      min-width: 0;
    }

    .fs-service-card.is-active {
      background: linear-gradient(180deg, #eefaf8 0%, #ffffff 100%);
      border-color: var(--teal-600);
      cursor: pointer;
    }

    .fs-service-card.is-disabled {
      opacity: 0.78;
      cursor: not-allowed;
    }

    .fs-card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
    }

    .fs-card-num {
      font-size: 13px;
      font-weight: 700;
      color: var(--slate-600);
    }

    .fs-status-active {
      display: inline-block;
      margin-top: 3px;
      font-size: 10.5px;
      font-weight: 800;
      color: var(--teal-700);
      background: var(--teal-soft);
      padding: 2px 8px;
      border-radius: 999px;
    }

    .fs-service-banner {
      width: 100%;
      height: 68px;
      border-radius: 12px;
      background: var(--surface-white);
      border: 1px solid var(--border-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .fs-service-card.is-active .fs-service-banner {
      background: #f0fdfa;
      border-color: #99f6e4;
    }

    .fs-service-card strong {
      display: block;
      font-size: 15px;
      color: var(--navy-900);
    }

    .fs-service-card small {
      display: block;
      margin-top: 3px;
      font-size: 12px;
      color: var(--slate-600);
    }

    .fs-orders-safe {
      padding-bottom: 128px;
    }

    .fs-order-card {
      background: var(--surface-white);
      border: 1px solid var(--border-soft);
      border-radius: 18px;
      padding: 16px;
      box-shadow: var(--shadow-card);
    }

    .fs-toast {
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: 76px;
      max-width: 448px;
      margin: 0 auto;
      padding: 12px 16px;
      border-radius: 14px;
      background: var(--teal-700);
      color: #ffffff;
      font-size: 13.5px;
      font-weight: 600;
      box-shadow: 0 10px 24px rgba(15, 39, 68, 0.18);
      z-index: 40;
    }

    .fs-bottom-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      height: 62px;
      background: var(--surface-white);
      border-top: 1px solid var(--border-soft);
      z-index: 30;
    }

    .fs-bottom-nav-inner {
      max-width: 480px;
      height: 100%;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .fs-bottom-nav button {
      border: none;
      background: transparent;
      color: var(--slate-600);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }

    .fs-bottom-nav button.is-active {
      color: var(--teal-700);
      font-weight: 700;
    }
  </style>
</head>
<body>
  <header class="fs-topbar">
    <div class="fs-topbar-inner">
      <div class="fs-brand">
        <strong>ASAS</strong>
        <span>Facility Services</span>
      </div>
      <button type="button" class="fs-pill-outline" data-action="go-orders">Order Saya</button>
    </div>
  </header>

  <main class="fs-container">
    <section class="fs-hero">
      <div class="fs-badges">
        <span class="fs-badge-navy">PILOT ZONA 1</span>
        <span class="fs-badge-light">SATU HUB</span>
      </div>
      <h1>Anda yang Utama</h1>
      <p>Jasa Setrika yang datang kepada Anda. Berat timbangan dan tagihan final diverifikasi langsung di Satu Hub.</p>
      <div class="fs-hero-actions">
        <button type="button" class="fs-btn-primary" data-action="open-booking">Pesan Sekarang</button>
        <button type="button" class="fs-btn-secondary" data-action="go-orders">Lihat Order Saya</button>
      </div>
    </section>

    <section id="sec-layanan" class="fs-section">
      <span class="fs-eyebrow">LAYANAN</span>
      <h2>Layanan yang siap membantu</h2>
      <p class="fs-sub">Jasa Setrika sudah tersedia di Zona 1. Layanan lainnya sedang kami persiapkan secara bertahap.</p>

      <div class="fs-services-panel">
        <div class="fs-services-grid">
          <!-- 01 Cleaning -->
          <div class="fs-service-card is-disabled" aria-disabled="true">
            <div class="fs-card-top">
              <span class="fs-card-num">01</span>
            </div>
            <div class="fs-service-banner" aria-hidden="true">
              <svg width="68" height="52" viewBox="0 0 68 52" fill="none">
                <rect x="24" y="18" width="16" height="24" rx="4" fill="#dbeafe" stroke="#1e3a5f" stroke-width="2"/>
                <rect x="27" y="11" width="10" height="7" rx="2" fill="#93c5fd" stroke="#1e3a5f" stroke-width="2"/>
                <path d="M32 25v9M27.5 29.5h9" stroke="#0f2744" stroke-width="2" stroke-linecap="round"/>
                <circle cx="46" cy="16" r="3" fill="#bae6fd"/>
                <circle cx="51" cy="23" r="2" fill="#7dd3fc"/>
              </svg>
            </div>
            <div>
              <strong>Cleaning</strong>
              <small>Belum tersedia</small>
            </div>
          </div>

          <!-- 02 AKTIF: Jasa Setrika -->
          <button type="button" class="fs-service-card is-active" data-service="IRONING">
            <div class="fs-card-top">
              <div>
                <span class="fs-card-num">02</span><br>
                <span class="fs-status-active">AKTIF</span>
              </div>
            </div>
            <div class="fs-service-banner" aria-hidden="true">
              <svg width="76" height="52" viewBox="0 0 76 52" fill="none">
                <rect x="12" y="34" width="24" height="7" rx="3" fill="#99f6e4" stroke="#0f766e" stroke-width="1.8"/>
                <rect x="14" y="27" width="20" height="7" rx="3" fill="#ccfbf1" stroke="#0f766e" stroke-width="1.8"/>
                <path d="M40 37h24l-2.5-10H47a5 5 0 0 0-5 5v5Z" fill="#5eead4" stroke="#0f766e" stroke-width="2" stroke-linejoin="round"/>
                <path d="M47 27v-5h10l2.5 5" stroke="#0f766e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M52 15c0-2 2-3 2-5M58 16c0-2 2-3 2-5" stroke="#0d9488" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <strong>Jasa Setrika</strong>
              <small>Antar-jemput Zona 1</small>
            </div>
          </button>

          <!-- 03 Maintenance -->
          <div class="fs-service-card is-disabled" aria-disabled="true">
            <div class="fs-card-top">
              <span class="fs-card-num">03</span>
            </div>
            <div class="fs-service-banner" aria-hidden="true">
              <svg width="68" height="52" viewBox="0 0 68 52" fill="none">
                <circle cx="34" cy="26" r="11" fill="#e2e8f0" stroke="#1e3a5f" stroke-width="2"/>
                <circle cx="34" cy="26" r="4.5" fill="#f7faff" stroke="#1e3a5f" stroke-width="2"/>
                <path d="M42 18l8-8 4 4-8 8" stroke="#1e3a5f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <strong>Maintenance</strong>
              <small>Belum tersedia</small>
            </div>
          </div>

          <!-- 04 Building & Facility -->
          <div class="fs-service-card is-disabled" aria-disabled="true">
            <div class="fs-card-top">
              <span class="fs-card-num">04</span>
            </div>
            <div class="fs-service-banner" aria-hidden="true">
              <svg width="72" height="52" viewBox="0 0 72 52" fill="none">
                <rect x="16" y="10" width="24" height="32" rx="3" fill="#dbeafe" stroke="#1e3a5f" stroke-width="2"/>
                <path d="M22 17h3M30 17h3M22 24h3M30 24h3M22 31h3M30 31h3" stroke="#1e3a5f" stroke-width="2" stroke-linecap="round"/>
                <circle cx="49" cy="26" r="5" fill="#fef08a" stroke="#1e3a5f" stroke-width="2"/>
                <path d="M49 31v11h4" stroke="#1e3a5f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <strong>Building &amp; Facility</strong>
              <small>Belum tersedia</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="sec-booking" class="fs-section" hidden>
      <span class="fs-eyebrow">FORM PEMESANAN · ZONA 1</span>
      <h2>Pesan Jasa Setrika</h2>
      <div class="fs-order-card">
        <input type="hidden" id="fsServiceCode" name="serviceCode" value="IRONING" />
        <label for="fsZoneSelect" style="display:block;font-size:13px;font-weight:700;margin-bottom:6px;">
          Kecamatan Zona 1 (Satu Hub)
        </label>
        <select id="fsZoneSelect" style="width:100%;padding:10px 12px;border-radius:12px;border:1px solid #dbe6f2;margin-bottom:12px;background:#fff;">
          <option value="">Pilih kecamatan Zona 1</option>
          <option value="Pandeglang">Pandeglang</option>
          <option value="Majasari">Majasari</option>
          <option value="Karang Tanjung">Karang Tanjung</option>
          <option value="Cadasari">Cadasari</option>
          <option value="Kaduhejo">Kaduhejo</option>
          <option value="Koroncong">Koroncong</option>
        </select>
        <label for="fsWeightInput" style="display:block;font-size:13px;font-weight:700;margin-bottom:6px;">
          Estimasi Berat (kg)
        </label>
        <input id="fsWeightInput" type="number" min="1" step="0.5" placeholder="Contoh: 3" style="width:100%;padding:10px 12px;border-radius:12px;border:1px solid #dbe6f2;margin-bottom:12px;" />
        <div class="fs-hero-actions">
          <button type="button" id="fsBtnShareLoc" class="fs-btn-secondary">Bagikan Lokasi</button>
          <button type="button" id="fsBtnSubmitOrder" class="fs-btn-primary">Kirim Pesanan</button>
        </div>
        <p id="fsLocStatus" class="fs-sub" style="margin:10px 0 0;"></p>
      </div>
    </section>

    <section id="sec-order" class="fs-section fs-orders-safe">
      <span class="fs-eyebrow">ORDER SAYA</span>
      <h2>Pantau Pesanan</h2>
      <div id="orderListContainer" class="fs-order-card">
        <p class="fs-sub" style="margin:0;">Pemesanan pilot Jasa Setrika Zona 1 siap digunakan.</p>
      </div>
    </section>
  </main>

  <div id="fsToast" class="fs-toast" role="status" aria-live="polite" hidden></div>

  <nav class="fs-bottom-nav" aria-label="Navigasi utama">
    <div class="fs-bottom-nav-inner">
      <button type="button" class="is-active" data-nav="home">Beranda</button>
      <button type="button" data-nav="services">Layanan</button>
      <button type="button" data-nav="orders">Order</button>
      <button type="button" data-nav="help">Bantuan</button>
    </div>
  </nav>

  <script>
    (() => {
      const toastEl = document.getElementById("fsToast");
      const orderSection = document.getElementById("sec-order");
      const bookingSection = document.getElementById("sec-booking");
      const navButtons = document.querySelectorAll(".fs-bottom-nav button[data-nav]");
      let toastTimer = null;

      function showToast(message) {
        if (!toastEl) return;
        toastEl.textContent = message;
        toastEl.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { toastEl.hidden = true; }, 3200);
      }

      function setActiveNav(navKey) {
        navButtons.forEach((btn) => btn.classList.toggle("is-active", btn.dataset.nav === navKey));
      }

      function scrollToEl(el, navKey) {
        if (!el) return;
        if (navKey) setActiveNav(navKey);
        const y = el.getBoundingClientRect().top + window.scrollY - 70;
        window.scrollTo({ top: Math.max(0, y), behavior: "smooth" });
      }

      function openBooking() {
        if (bookingSection) {
          bookingSection.hidden = false;
          scrollToEl(bookingSection, "services");
        }
        showToast("Jasa Setrika (02 AKTIF) siap dipesan untuk Zona 1.");
      }

      document.addEventListener("click", (e) => {
        const act = e.target.closest("[data-action]")?.dataset.action;
        if (act === "open-booking") return openBooking();
        if (act === "go-orders") {
          scrollToEl(orderSection, "orders");
          return showToast("Menampilkan bagian Order Saya.");
        }
        if (e.target.closest(".fs-service-card.is-active")) return openBooking();
        const disabledCard = e.target.closest(".fs-service-card.is-disabled");
        if (disabledCard) {
          const name = disabledCard.querySelector("strong")?.textContent?.trim() || "Layanan ini";
          return showToast(`${name} belum tersedia pada pilot Zona 1.`);
        }
        const navBtn = e.target.closest(".fs-bottom-nav button[data-nav]");
        if (navBtn) {
          const key = navBtn.dataset.nav;
          setActiveNav(key);
          if (key === "home") window.scrollTo({ top: 0, behavior: "smooth" });
          else if (key === "services") scrollToEl(document.getElementById("sec-layanan"), "services");
          else if (key === "orders") scrollToEl(orderSection, "orders");
          else if (key === "help") showToast("Pilot Zona 1 · Satu Hub: verifikasi berat & tagihan di hub.");
        }
      });
    })();
  </script>
</body>
</html>
